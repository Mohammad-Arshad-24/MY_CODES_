/**
 * Definition for a binary tree node.
 * public class TreeNode {
 *     int val;
 *     TreeNode left;
 *     TreeNode right;
 *     TreeNode() {}
 *     TreeNode(int val) { this.val = val; }
 *     TreeNode(int val, TreeNode left, TreeNode right) {
 *         this.val = val;
 *         this.left = left;
 *         this.right = right;
 *     }
 * }
 */
class Solution {
    public boolean isSameTree(TreeNode p, TreeNode q) {
        ArrayList<TreeNode> a = new ArrayList<>();
        ArrayList<TreeNode> b = new ArrayList<>();
        a.add(p);
        b.add(q);
        while (!a.isEmpty()) {
            TreeNode x =a.remove(0);
            TreeNode y =b.remove(0);
            if (x==null && y==null) {
                continue;}
            if (x==null || y==null) {
                return false;
            }
            if (x.val!=y.val) {
                return false;
            }
            a.add(x.left);
            a.add(x.right);
            b.add(y.left);
            b.add(y.right);
        }
        return true;
    }}
