class Solution {
    public String replaceDigits(String s) {
        String res = "";
        for (int i =0; i<s.length();i++) {
            if (Character.isDigit(s.charAt(i))) {
            char r=(char)(s.charAt(i-1)+(s.charAt(i)-'0'));
                res+=r;
            } else {
                res+=s.charAt(i);
            }
        }
        return res;
    }
}
