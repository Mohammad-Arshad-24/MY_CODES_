class Solution {
    public int maxPower(String s) {
        int max=1;
        int t=1;
        for(int i=0;i<s.length()-1;i++){
            char curr=s.charAt(i);
            if(curr==s.charAt(i+1)){
                t++;
                max=Math.max(max,t);
            }
            else{
            t=1;
            }}
        return max;
    }
}
