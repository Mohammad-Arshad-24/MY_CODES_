class Solution {
    public boolean isArraySpecial(int[] nums) {
        int j=0;
        boolean res=true;
        if(nums.length==1){
            return true;
        }
        for(int i=1;i<nums.length;i++){
            if(!((nums[j]%2==0 && nums[i]%2!=0) || (nums[i]%2==0 && nums[j]%2!=0))){
                return false;
            }
            j++;
        }
        return res;
    }
}
