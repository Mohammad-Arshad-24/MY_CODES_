class Solution {
    public int smallestIndex(int[] nums) {
        int res=Integer.MAX_VALUE;
        for(int i=0;i<nums.length;i++){
            int curr=nums[i];
            int s=0;
            while(curr>0){
                int temp=curr%10;
                s+=temp;
                curr/=10;
            }
            System.out.println(s+"    "+i);
            if(s==i){
                res=Math.min(res,i);
            }  
        }
        if(res==Integer.MAX_VALUE){return -1;}
        return res;
    }
}
