class Solution {
    public int maximum69Number (int num) {
        String s=""+num;
        char[] r=s.toCharArray();
        for(int i=0;i<r.length;i++){
            if(r[i]=='6'){
                r[i]='9';
            break;
            }
        }
        return Integer.parseInt(new String(r));
    }
}
