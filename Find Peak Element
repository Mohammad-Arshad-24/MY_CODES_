class Solution {
    public int findPeakElement(int[] nums) {
        int i=0;
        if(nums.length==1){
            return 0;
        }
        if(nums[i]>nums[1]){
            return i;
        }
        for( i =1;i<nums.length-1;i++){
            if(nums[i-1]<nums[i] && nums[i+1]<nums[i]){
                return i;
            }
        }
        return i;
    }
}
