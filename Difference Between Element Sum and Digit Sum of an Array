class Solution {
    public int differenceOfSum(int[] nums) {
        int s=0;
        int sum=0;
        for(int i=0;i<nums.length;i++){
            sum+=nums[i];
            int n=nums[i];
            while(n>0){
                int r=n%10;
                s+=r;
                n/=10;
            }
        }
            return Math.abs(sum-s);
            }
}
