class Solution {
    public List<Integer> findDuplicates(int[] nums) {
        ArrayList<Integer> res=new ArrayList<>();
        HashMap<Integer,Integer> h=new HashMap<>();
        for(int i=0;i<nums.length;i++){
            if(!h.containsKey(nums[i])){
            h.put(nums[i],1);}
            else{
                res.add(nums[i]);
            }
        }
        return res;
    }
}
