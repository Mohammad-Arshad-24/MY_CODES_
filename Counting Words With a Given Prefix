class Solution {
    public int prefixCount(String[] words, String pref) {
        int l=pref.length();
        int res=0;
        for(int i=0;i<words.length;i++){
            String curr=words[i];
            int c=0;
            for(int j=0;j<pref.length();j++){
                if(curr.length()<pref.length()){break;}
                if(curr.charAt(j)==pref.charAt(j)){
                    c++;
                }
            }
                            if(l==c){
                    res++;
                }
        }
        return res;
    }
}
