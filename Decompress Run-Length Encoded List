class Solution {
    public int[] decompressRLElist(int[] nums) {
        int s = 0;
        for (int i = 0; i < nums.length; i += 2) {
            s += nums[i];
        }
        int[] res = new int[s];
        int idx = 0;

        for (int i = 0; i < nums.length; i += 2) {
            int f = nums[i];
            int val = nums[i + 1];

            for (int j = 0; j < f; j++) {
                res[idx] = val;
                idx++;
            }
        }
        return res;
    }
}
