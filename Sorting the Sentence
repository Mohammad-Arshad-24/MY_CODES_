class Solution {
    public String sortSentence(String s) {
        String[] r=s.split(" ");
        String[] c=new String[r.length];
        String res="";
        for(int i=0;i<r.length;i++){
            int l=r[i].length();
            int idx = (r[i].charAt(l-1))-'0';
            c[idx-1]=r[i].substring(0,l-1);
        }
        return String.join(" ",c);
    }
}
