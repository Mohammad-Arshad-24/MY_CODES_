class Solution {
    public int sumIndicesWithKSetBits(List<Integer> nums, int k) {
        int res=0;
        for(int i=0;i<nums.size();i++){
            int n=i;
            int c=0;
            while(n>0){
                int r=n%2;
                if(r==1){
                    c++;
                }
                n/=2;
            }
            if(c==k){res+=nums.get(i);}            
        }
        return res;
    }
}
