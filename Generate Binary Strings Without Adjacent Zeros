import java.util.*;

class Solution {
    public List<String> validStrings(int n) {
       ArrayList<String> res = new ArrayList<>();
        for (int i=0;i<(Math.pow(2,n));i++) {
            String s=Integer.toBinaryString(i);
            while(s.length()<n){
            s="0"+s;}
            if(!s.contains("00"))
                res.add(s);
        }
        return res;
    }
}
