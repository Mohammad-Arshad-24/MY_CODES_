    public int[] twoSum(int[] nums, int target) {
        int c=0;
        int l=0;
        while(c<=nums.length-1){
        int r=nums.length-1;
            while(l<r){
                if(nums[l]+nums[r]==target){
                    return new int[] {l + 1, r + 1};
                }
                r--;
            }
            l++;
            c++;
        }
        return new int[] {};
