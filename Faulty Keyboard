class Solution {
    public String finalString(String s) {
        String res="";
        for(int i=0;i<s.length();i++){
            if(s.charAt(i)=='i'){
                String temp="";
                for(int j=res.length()-1;j>=0;j--){
                    temp+=res.charAt(j);}
                res=temp;
            }
            else{
                res+=s.charAt(i);
            }}
        return res;
    }
}
