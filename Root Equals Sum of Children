/**
 * Definition for a binary tree node.
 * public class TreeNode {
 *     int val;
 *     TreeNode left;
 *     TreeNode right;
 *     TreeNode() {}
 *     TreeNode(int val) { this.val = val; }
 *     TreeNode(int val, TreeNode left, TreeNode right) {
 *         this.val = val;
 *         this.left = left;
 *         this.right = right;
 *     }
 * }
 */
class Solution {
    public boolean checkTree(TreeNode root) {
        int s=0;
        if(root!=null){
        if(root.left!=null){
            s+=root.left.val;
        }
                if(root.right!=null){
            s+=root.right.val;
        }
        }
        if(s==root.val){
            return true;}
                return false;
        }
}
