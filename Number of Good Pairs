class Solution {
    public int numIdenticalPairs(int[] nums) {
        int c=0;
        int res=0;
        while(c<nums.length-1){
            for(int i=c+1;i<nums.length;i++){
                if(nums[c]==nums[i]){
                    res++;
                }
            
            }
                c++;
        }
        return res;
    }
}
